# 复制为 .env.production 后在服务器执行 npm run build
# Vite 会把 VITE_* 写进打包 JS，改 env 后必须重新 build

VITE_BACKEND_URL=https://applebearbaby.net
VITE_SITE_URL=https://applebearbaby.net

VITE_GOOGLE_ADS_ID=AW-11136202142
VITE_GOOGLE_ADS_PURCHASE_CONVERSION=Q6NVCN-u8oYZEJ7rk74p
# 潜在客户表单标签已写死在 src/googleAds.js（PPkhCIXD7bYcEJ7rk74p），无需再配此项
# VITE_GOOGLE_ADS_LEAD_CONVERSION=PPkhCIXD7bYcEJ7rk74p
VITE_GOOGLE_ADS_CURRENCY=USD
# 询盘是否同时上报「购买」（默认不上报，只上报潜在客户表单）
# VITE_GOOGLE_ADS_TRACK_PURCHASE_ON_INQUIRY=true
