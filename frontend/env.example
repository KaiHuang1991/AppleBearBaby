# Frontend Environment Variables
# 将此文件重命名为 .env

# 后端 API 地址（仅 origin，不要加 /api 后缀；接口路径已含 /api/...）
# 本机开发：
VITE_BACKEND_URL=http://localhost:4000
# 手机访问 http://YOUR_PC_IP:5173 时改为电脑局域网 IP：
# VITE_BACKEND_URL=http://192.168.1.126:4000
#
# 生产构建请用 frontend/.env.production（vite build 自动加载），勿把上面的 localhost 打进线上包。
# 例：VITE_BACKEND_URL=https://applebearbaby.net

# 生产环境站点根 URL（Facebook 分享必须用公网 https；与 FRONTEND_URL 一致）
# 写入 frontend/.env.production 后重新 npm run build
# VITE_SITE_URL=https://applebearbaby.net

# Google / Facebook 社交登录（与 backend 中 GOOGLE_CLIENT_ID、FACEBOOK_APP_ID 对应）
# VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# 与 backend FACEBOOK_APP_ID 相同；用于登录及 OG fb:app_id（Sharing Debugger 警告）
VITE_FACEBOOK_APP_ID=1525414968949463

# Google Ads 转化跟踪（留空则不加载；生产请写在 frontend/.env.production）
# VITE_GOOGLE_ADS_ID=AW-11136202142
# 询盘邮件提交成功
# VITE_GOOGLE_ADS_PURCHASE_CONVERSION=Q6NVCN-u8oYZEJ7rk74p
# 用户注册成功（需在 Google Ads 单独创建「注册」转化操作，复制其转化标签）
# VITE_GOOGLE_ADS_SIGNUP_CONVERSION=xxxxxxxxxx
# VITE_GOOGLE_ADS_CURRENCY=SGD
