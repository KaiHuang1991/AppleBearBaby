# Frontend Environment Variables
# 将此文件重命名为 .env

# 后端 API 地址（仅 origin，不要加 /api 后缀；接口路径已含 /api/...）
# 本机开发：
VITE_BACKEND_URL=http://localhost:4000
# 手机访问 http://YOUR_PC_IP:5173 时改为电脑局域网 IP：
# VITE_BACKEND_URL=http://192.168.1.126:4000
#
# 生产构建请用 frontend/.env.production（vite build 自动加载），勿把上面的 localhost 打进线上包。
# 例：VITE_BACKEND_URL=https://applebearbaby.net

# 可选：生产环境站点根 URL，用于分享预览与结构化数据（例：https://applebearbaby.net）
# VITE_SITE_URL=https://applebearbaby.net

# Google / Facebook 社交登录（与 backend 中 GOOGLE_CLIENT_ID、FACEBOOK_APP_ID 对应）
# VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# VITE_FACEBOOK_APP_ID=your_facebook_app_id
