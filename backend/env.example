# ==========================================
# E-commerce App Backend Configuration
# ==========================================
# 将此文件重命名为 .env 并填写实际值

# ==========================================
# MongoDB Database Configuration
# ==========================================

# Option 1: Local MongoDB
MONGODB_URI=mongodb://localhost:27017

# Option 2: MongoDB Atlas (推荐)
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net

# ==========================================
# Cloudinary Configuration
# ==========================================

CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET_KEY=your_secret_key

# ==========================================
# JWT Configuration
# ==========================================

JWT_SECRET=your_very_long_random_secret_key_here

# ==========================================
# Server Configuration
# ==========================================

PORT=4000
FRONTEND_URL=http://localhost:5173

# 生产环境允许的域名（用逗号分隔）
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ==========================================
# Email Configuration
# ==========================================

# QQ邮箱配置（用于发送验证邮件等）
EMAIL_USER=your_email@qq.com
EMAIL_PASSWORD=your_email_app_password

# 接收询盘邮件的邮箱地址
INQUIRY_RECEIVER_EMAIL=your_inquiry_receiver@example.com

# 新用户注册通知收件人固定为 applebearh@gmail.com（见 backend/config/emailConfig.js）

# ==========================================
# Admin Configuration
# ==========================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# ==========================================
# Google Sign-In（用户登录，Web 客户端 ID）
# ==========================================
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
# 授权 JavaScript 来源需包含前端地址（如 http://localhost:5173）

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 服务端 Google 跳转登录回调（填到 Cloud Console → Authorized redirect URIs）
# http://localhost:4000/api/user/auth/google/callback
# http://127.0.0.1:4000/api/user/auth/google/callback
BACKEND_URL=http://localhost:4000
GOOGLE_REDIRECT_URI=http://localhost:4000/api/user/auth/google/callback

# 国内/无法直连 Google 时，为后端配置代理（Clash 等常见端口 7890）
# GOOGLE_HTTPS_PROXY=http://127.0.0.1:7890
# 或使用系统变量 HTTPS_PROXY=http://127.0.0.1:7890

# 以下为 Gmail API 发信脚本用（可选，与登录无关）
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:3000
# REFRESH_TOKEN=your_refresh_token

# ==========================================
# Facebook Login
# ==========================================
# developers.facebook.com → 应用 → 设置 → 基本 → 应用编号 / 应用密钥

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

